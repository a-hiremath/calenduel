{
  "name": "calenduel-focus",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ai": { "binding": "AI" },
  "ratelimits": [{
    "name": "LIMITER",
    "namespace_id": "912001",
    "simple": { "limit": 120, "period": 60 }
  }],
  "vars": {
    "AUTH_ISSUER": "https://ep-lingering-wave-bdsrabit.neonauth.c-8.us-east-2.aws.neon.tech",
    "JWKS_URL": "https://ep-lingering-wave-bdsrabit.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    "ALLOWED_ORIGIN": "https://calenduel.com"
  }
}
